# Global hotkeys (skhd). Reload: skhd --restart-service

# Monitor brightness (~/Projects/mac-setup/tools/display-brightness)
ctrl + alt + cmd - b    : /usr/bin/python3 ~/Projects/mac-setup/tools/display-brightness/brightness.py toggle
ctrl + alt + cmd - up   : /usr/bin/python3 ~/Projects/mac-setup/tools/display-brightness/brightness.py up
ctrl + alt + cmd - down : /usr/bin/python3 ~/Projects/mac-setup/tools/display-brightness/brightness.py down
