{
  "$schema": "https://opencode.ai/config.json",
  "model": "local/qwen-local",
  "small_model": "local/qwen-local",
  "share": "disabled",
  "autoupdate": false,
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Roland local (llama-server, ~/Projects/local-llm)",
      "options": { "baseURL": "http://127.0.0.1:8768/v1" },
      "models": {
        "qwen-local": {
          "name": "Qwen3.6 35B-A3B (fast, no thinking)",
          "tool_call": true,
          "limit": { "context": 131072, "output": 8192 }
        },
        "qwen-local-think": {
          "id": "qwen-local",
          "name": "Qwen3.6 35B-A3B (thinking)",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 131072, "output": 16384 },
          "options": { "chat_template_kwargs": { "enable_thinking": true } }
        },
        "venice-local": {
          "name": "Venice Uncensored 24B (chat, weak coder)",
          "tool_call": true,
          "temperature": true,
          "limit": { "context": 32768, "output": 8192 }
        }
      }
    }
  },
  "mcp": {
    "readwise": {
      "type": "remote",
      "url": "https://mcp2.readwise.io/mcp",
      "enabled": true
    }
  }
}
